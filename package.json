{
  "name": "zhihu-blocker",
  "displayName": "Zhihu blocker",
  "version": "0.0.1",
  "description": "Hide ads and promotional modules on Zhihu, with optional AI soft-ad detection via your own DeepSeek API key.",
  "author": "kaiyang939325@gmail.com",
  "license": "MIT",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "jsdom": "^30.1.1",
    "prettier": "3.2.4",
    "sharp": "^0.35.4",
    "typescript": "5.3.3",
    "vitest": "^4.1.10"
  },
  "manifest": {
    "minimum_chrome_version": "102",
    "host_permissions": [
      "https://*.zhihu.com/*",
      "https://zhihu.com/*",
      "https://api.deepseek.com/*"
    ],
    "permissions": [
      "storage"
    ]
  }
}
